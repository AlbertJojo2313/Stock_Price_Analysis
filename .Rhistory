subset_sample <- function(stocks, nrows) {
subset_df <- list()
for (symbol in names(stocks)) {
df <- stocks[[symbol]]
sampled <- df %>% sample_n(min(nrows, nrow(df)))
subset_df[[symbol]] <- sampled
}
return(subset_df)
}
