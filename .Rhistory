run_full_analysis <- function(filepath = "data/insurance.csv",
y_var = "charges",
create_all_plots = TRUE) {
cat("\n", "="*80, "\n")
cat("INSURANCE DATA ANALYSIS SUITE\n")
cat("="*80, "\n\n")
# Load and process data
cat("Loading data...\n")
df_original <- load_data(filepath)
df_encoded <- process_data(df_original)
# Generate summary statistics
cat("Generating summary statistics...\n")
generate_summary_stats(df_original)
if (create_all_plots) {
# Correlation plot
cat("Creating correlation plot...\n")
plot_correlation(df_encoded)
# Distribution plots
cat("Creating histograms...\n")
plot_histograms(df_encoded)
cat("Creating categorical bar plots...\n")
plot_categorical_bars(df_original)
# Box plots
cat("Creating boxplots...\n")
plot_boxplots(df_encoded)
if (y_var %in% names(df_original)) {
cat("Creating categorical boxplots...\n")
categorical_cols <- names(df_original)[sapply(df_original, is.character) |
sapply(df_original, is.factor)]
if (length(categorical_cols) > 0) {
plot_boxplots_by_category(df_original, y_var, categorical_cols)
}
}
# Scatter plots
if (y_var %in% names(df_encoded)) {
cat("Creating scatterplots...\n")
plot_scatterplots(df_encoded, y_var)
}
cat("Creating scatter matrix...\n")
plot_scatter_matrix(df_encoded)
# Advanced plots
cat("Creating Q-Q plots...\n")
plot_qq_plots(df_encoded)
cat("Creating density plots...\n")
plot_density(df_encoded)
}
cat("\n", "="*80, "\n")
cat("ANALYSIS COMPLETE!\n")
cat("All plots saved to 'plots/' directory\n")
cat("="*80, "\n\n")
return(list(original = df_original, encoded = df_encoded))
}
# Run full analysis
datasets <- run_full_analysis("data/insurance.csv", y_var = "charges")
