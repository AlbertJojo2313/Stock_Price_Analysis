# --- Data Structure ---
process_data <- function(df) {
dummies <- dummyVars("~.", data = df)
df_encoded <- predict(dummies, newdata = df, fullRank = TRUE)
colnames(df_encoded) <- gsub("Region_", "R_", colnames(df_encoded))
colnames(df_encoded) <- gsub("Smoker_", "S_", colnames(df_encoded))
colnames(df_encoded) <- gsub("Sex_", "G_", colnames(df_encoded))
return(df_encoded)
}
encoded_df <- process_data(df)
# numeric_cols <- df %>% select(where(is.numeric))
corr_matrix <- cor(encoded_df, use = "complete.obs")
png("corrplot_large.png", width = 1600, height = 1200, res = 200)
